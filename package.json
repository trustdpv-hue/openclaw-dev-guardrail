  "repository": {
    "type": "git",
    "url": "https://github.com/trustdpv/openclaw-dev-guardrail.git"
  },
  "bugs": {
    "url": "https://github.com/trustdpv/openclaw-dev-guardrail/issues"
  },
  "homepage": "https://github.com/trustdpv/openclaw-dev-guardrail#readme",
  "openclaw": {
    "extensions": ["./dist/index.js"]
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.5"
